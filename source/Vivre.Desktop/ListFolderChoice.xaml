<UserControl x:Class="Vivre.Desktop.ListFolderChoice"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Vivre.Desktop">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Folder" Margin="0,0,0,6"/>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox x:Name="Folders" MinWidth="140" DisplayMemberPath="Label" SelectionChanged="OnSelectionChanged"
             AutomationProperties.Name="List folder" HorizontalContentAlignment="Stretch"/>
   <ui:Button x:Name="NewFolderButton" Grid.Column="1" Content="New folder…" Margin="8,0,0,0" Click="OnNewFolder"/>
  </Grid>
  <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" local:AccessibleStatus.Enabled="True" Margin="0,4,0,0"/>
 </Grid>
</UserControl>
