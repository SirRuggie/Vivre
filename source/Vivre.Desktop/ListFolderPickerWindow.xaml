<ui:FluentWindow x:Class="Vivre.Desktop.ListFolderPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:local="clr-namespace:Vivre.Desktop"
 Title="Move to folder" Width="480" Height="420" MinWidth="360" MinHeight="320"
 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:TitleBar Title="Move to folder"/>
  <StackPanel Grid.Row="1" Margin="24,8,24,8">
   <TextBlock x:Name="ListNameText" TextWrapping="Wrap" Margin="0,0,0,8"/>
   <ui:TextBox x:Name="FolderSearch" PlaceholderText="Search folders…" AutomationProperties.Name="Search destination folders"
               ClearButtonEnabled="True" TextChanged="OnSearchChanged"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="24,0">
   <ListBox x:Name="Destinations" DisplayMemberPath="Label" SelectionChanged="OnSelectionChanged"
            AutomationProperties.Name="Destination folder"/>
   <TextBlock x:Name="NoMatchesText" Text="No folders match. Clear the search to see all destinations."
              Visibility="Collapsed" IsHitTestVisible="False" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center"/>
  </Grid>
  <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="24,6" TextWrapping="Wrap" local:AccessibleStatus.Enabled="True"
             Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,16">
   <ui:Button x:Name="MoveButton" Content="Move" Appearance="Primary" IsDefault="True" IsEnabled="False" Click="OnMove"/>
   <ui:Button Content="Cancel" IsCancel="True" Margin="8,0,0,0"/>
  </StackPanel>
 </Grid>
</ui:FluentWindow>
