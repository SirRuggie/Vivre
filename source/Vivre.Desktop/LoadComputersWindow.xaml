<ui:FluentWindow x:Class="Vivre.Desktop.LoadComputersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Paste machines"
        Height="520" Width="460"
        MinHeight="400" MinWidth="380"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Paste machines" />

        <StackPanel Grid.Row="1" Margin="24,4,24,8">
            <ui:TextBlock TextWrapping="Wrap" Text="Separate machine names with lines, spaces, commas, or semicolons." />
            <RadioButton x:Name="AddMode" Checked="OnModeChanged" Content="Add to this tab — keep existing results" IsChecked="True" Margin="0,8,0,0" />
            <RadioButton x:Name="ReplaceMode" Checked="OnModeChanged" Content="Replace this tab's machine list" Margin="0,6,0,0" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <TextBox Grid.Row="2"
                 x:Name="NamesBox"
                 Margin="24,0,24,0"
                 AcceptsReturn="True"
                 AcceptsTab="False"
                 FontFamily="Cascadia Code, Consolas, monospace"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,16">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" x:Name="ApplyButton" Content="Add machines" Click="OnLoad" />
            <ui:Button Margin="8,0,0,0" Content="Cancel" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
