<UserControl x:Class="Vivre.Desktop.PeopleView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:Vivre.Desktop"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Background="{DynamicResource ApplicationBackgroundBrush}">
 <UserControl.Resources>
  <local:InverseBooleanConverter x:Key="InverseBool"/>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
 </UserControl.Resources>
 <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid MinHeight="620" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="People · Email lookup" FontSize="24" Margin="0,0,0,8"/>
   <WrapPanel>
    <ui:Button Content="Paste people" Click="OnPaste" Margin="0,0,8,8"/>
    <ui:Button Content="{Binding ReviewLabel}" Click="OnReview" Margin="0,0,8,8"/>
    <ui:Button Content="Copy resolved emails" Click="OnCopyResolved" Margin="0,0,8,8"/>
    <ui:Button Content="Export all to CSV…" Click="OnExport" Margin="0,0,8,8"/>
    <ui:Button Content="Retry unresolved" Click="OnRetry" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,0,8,8"/>
    <ui:Button Content="Clear results" Click="OnClear" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" Margin="0,0,8,8"/>
    <ui:Button Content="Stop" Click="OnStop" IsEnabled="{Binding IsBusy}" Margin="0,0,8,8"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel Grid.Row="1" Margin="0,0,0,8">
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <WrapPanel Margin="0,8,0,0">
    <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="150" AutomationProperties.Name="People result filter"/>
    <TextBlock Text="{Binding Summary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
   </WrapPanel>
  </StackPanel>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
     IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
     EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="100"
     PreviewMouseRightButtonDown="OnRowRightClick" ContextMenuOpening="OnMenuOpening"
     MouseDoubleClick="OnDoubleClick" AutomationProperties.Name="People lookup results">
    <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
    <DataGrid.Columns>
     <DataGridTextColumn Header="Original input" Binding="{Binding Input}" Width="145"/>
     <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
     <DataGridTextColumn Header="Matched name" Binding="{Binding MatchedName}" Width="170"/>
     <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120"/>
     <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="230"/>
     <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130"/>
     <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="90"/>

     <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="240"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="1" Visibility="{Binding HasReview, Converter={StaticResource BoolToVis}}"
     BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" Padding="10" Margin="0,10,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding ReviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Grid.Row="1" Text="{Binding ReviewRow.Detail}" TextWrapping="Wrap" Margin="0,4,0,6"/>
     <DataGrid Grid.Row="2" ItemsSource="{Binding ReviewRow.Candidates}" SelectedItem="{Binding SelectedCandidate}"
       AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
       AutomationProperties.Name="Candidate accounts">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Name" Binding="{Binding Person.Name}" Width="160"/>
       <DataGridTextColumn Header="Username" Binding="{Binding Person.Username}" Width="110"/>
       <DataGridTextColumn Header="Email" Binding="{Binding Person.Email}" Width="210"/>
       <DataGridTextColumn Header="Department" Binding="{Binding Person.Department}" Width="110"/>
       <DataGridTextColumn Header="Enabled" Binding="{Binding Person.Enabled}" Width="75"/>
       <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="140"/>
       <DataGridTextColumn Header="Title" Binding="{Binding Person.Title}" Width="140"/>
       <DataGridTextColumn Header="Office" Binding="{Binding Person.Office}" Width="110"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Grid.Row="3" Margin="0,8,0,0">
      <ui:Button Content="Use selected match" Click="OnAccept" IsEnabled="{Binding HasCandidate}" Margin="0,0,8,0"/>
      <ui:Button Content="Skip for now" Click="OnSkip" Margin="0,0,8,0"/>
      <ui:Button Content="Close review" Click="OnCloseReview"/>
     </WrapPanel>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="Right-click rows to copy fields, review a match, or edit an entry. Resolved emails exclude guesses; no email is invented from a username." TextWrapping="Wrap" Margin="0,8,0,0"/>
 </Grid>
 </ScrollViewer>
</UserControl>
