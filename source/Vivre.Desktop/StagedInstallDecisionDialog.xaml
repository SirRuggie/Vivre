<ui:FluentWindow x:Class="Vivre.Desktop.StagedInstallDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Server 2016 CU installation"
        Height="520" Width="600"
        MinHeight="440" MinWidth="520"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Server 2016 CU installation">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Box24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,8,20,8">
            <StackPanel>
                <!-- KB mismatch warning (Settings vs scan) — only shown when there is a disagreement. -->
                <ui:InfoBar x:Name="MismatchBar" Severity="Warning" IsOpen="False" IsClosable="False"
                            Title="Settings may have the wrong CU" Margin="0,0,0,14" />

                <TextBlock TextWrapping="Wrap" FontSize="13"
                           Text="These Server 2016 machines use the CU lane and still need this month's cumulative update. Install CU copies and installs the full package using DISM without rebooting. Installation can affect performance; reboot later to complete." />

                <TextBlock Text="Machines waiting for the CU:" FontWeight="SemiBold" Margin="0,14,0,4" />
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="12,8">
                    <TextBlock x:Name="BoxListText" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="OthersNote" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                           Text="" />

                <!-- Inline minor-only reboot caution — revealed when "Install minor updates only" is chosen. -->
                <ui:InfoBar x:Name="MinorRebootBar" Severity="Warning" IsOpen="False" IsClosable="False"
                            Margin="0,16,0,0"
                            Title="Minor updates may require a reboot"
                            Message="One or more minor updates may require a reboot. You'll need to reboot before installing the CU afterward. Proceed with minor updates first?" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
            <Grid>
                <!-- Main choices. -->
                <StackPanel x:Name="ChoiceButtons">
                    <!-- Primary recommended action: Stage the CU first. -->
                    <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Appearance="Primary" IsDefault="True" Click="OnStageCu" Margin="0,0,0,4"
                               Icon="{ui:SymbolIcon Box24}" Content="Install CU (no reboot)" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                               Margin="2,0,0,12" TextWrapping="Wrap"
                               Text="Recommended before other updates. Package size and installation time vary; this starts installation, not just a file copy." />

                    <ui:Button x:Name="SkipCuButton" Visibility="Collapsed" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Click="OnSkipCu" Margin="0,0,0,8"
                               ToolTip="Leave CU machines untouched and install updates only on the other machines in this batch." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Install minor updates only" Click="OnMinorOnly"
                                   ToolTip="Install the non-cumulative updates now via Windows Update; the CU is installed separately." />
                    </StackPanel>
                </StackPanel>

                <!-- Minor-only confirmation (swapped in when "Install minor updates only" is chosen). -->
                <StackPanel x:Name="MinorConfirmButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="Collapsed">
                    <ui:Button x:Name="MinorProceedButton" Content="Proceed with minor updates" Appearance="Primary"
                               Click="OnMinorProceed" Margin="0,0,8,0" />
                    <ui:Button Content="Back" Click="OnMinorBack" />
                </StackPanel>
            </Grid>
                <ui:Button x:Name="CancelInstallButton" Content="Cancel" IsCancel="True" Click="OnCancel"
                           HorizontalAlignment="Right" Margin="0,8,0,0"
                           ToolTip="Cancel this batch. No new installations start; work already running is unaffected." />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
